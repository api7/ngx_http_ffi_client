ngx_addon_name=ngx_http_ffi_client_module

ngx_http_ffi_client_lua_module_dir="${NGX_HTTP_LUA_MODULE_DIR:-}"
ngx_http_ffi_client_use_hyper="${NGX_HTTP_FFI_CLIENT_USE_HYPER:-0}"
ngx_http_ffi_client_hyper_keepalive_bench="${NGX_HTTP_FFI_CLIENT_HYPER_KEEPALIVE_BENCH:-0}"
ngx_http_ffi_client_hyper_borrow_response_bench="${NGX_HTTP_FFI_CLIENT_HYPER_BORROW_RESPONSE_BENCH:-0}"
ngx_http_ffi_client_hyper_session_bench="${NGX_HTTP_FFI_CLIENT_HYPER_SESSION_BENCH:-0}"

if [ -z "$ngx_http_ffi_client_lua_module_dir" ]; then
    if [ -f "$ngx_addon_dir/../lua-nginx-module/src/api/ngx_http_lua_api.h" ]; then
        ngx_http_ffi_client_lua_module_dir="$(cd "$ngx_addon_dir/../lua-nginx-module" && pwd)"
    else
        ngx_http_ffi_client_lua_module_dir="/home/rain/git/lua-nginx-module"
    fi
fi

if [ ! -f "$ngx_http_ffi_client_lua_module_dir/src/api/ngx_http_lua_api.h" ]; then
    cat << END
$0: error: ngx_http_ffi_client requires ngx_http_lua_api.h.
Set NGX_HTTP_LUA_MODULE_DIR to a lua-nginx-module checkout, for example:
NGX_HTTP_LUA_MODULE_DIR=/home/rain/git/lua-nginx-module
END
    exit 1
fi

if [ "$ngx_http_ffi_client_use_hyper" = "1" ]; then
    ngx_http_ffi_client_hyper_manifest="$ngx_addon_dir/rust/hyper-http11/Cargo.toml"
    ngx_http_ffi_client_hyper_target="$ngx_addon_dir/rust/hyper-http11/target"
    ngx_http_ffi_client_hyper_lib="$ngx_http_ffi_client_hyper_target/release/libngx_http_ffi_client_hyper.a"

    CARGO_TARGET_DIR="$ngx_http_ffi_client_hyper_target" cargo build --release --manifest-path "$ngx_http_ffi_client_hyper_manifest" || exit 1

    if [ ! -f "$ngx_http_ffi_client_hyper_lib" ]; then
        cat << END
$0: error: expected Rust hyper static library was not built:
$ngx_http_ffi_client_hyper_lib
END
        exit 1
    fi

    CFLAGS="$CFLAGS -DNGX_HTTP_FFI_CLIENT_USE_HYPER=1"
    if [ "$ngx_http_ffi_client_hyper_keepalive_bench" = "1" ] \
       || [ "$ngx_http_ffi_client_hyper_borrow_response_bench" = "1" ] \
       || [ "$ngx_http_ffi_client_hyper_session_bench" = "1" ]; then
        CFLAGS="$CFLAGS -DNGX_HTTP_FFI_CLIENT_HYPER_KEEPALIVE_BENCH=1"
    fi
    if [ "$ngx_http_ffi_client_hyper_borrow_response_bench" = "1" ]; then
        CFLAGS="$CFLAGS -DNGX_HTTP_FFI_CLIENT_HYPER_BORROW_RESPONSE_BENCH=1"
    fi
    if [ "$ngx_http_ffi_client_hyper_session_bench" = "1" ]; then
        CFLAGS="$CFLAGS -DNGX_HTTP_FFI_CLIENT_HYPER_SESSION_BENCH=1"
    fi

    CORE_LIBS="$CORE_LIBS $ngx_http_ffi_client_hyper_lib"
fi

HTTP_MODULES="$HTTP_MODULES ngx_http_ffi_client_module"
NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
    $ngx_addon_dir/src/ngx_http_ffi_client_module.c \
    $ngx_addon_dir/src/ngx_http_ffi_client_lua.c \
    $ngx_addon_dir/src/ngx_http_ffi_client_keepalive.c \
    $ngx_addon_dir/src/ngx_http_ffi_client_request.c \
    $ngx_addon_dir/src/ngx_http_ffi_client_response.c"

if [ "$ngx_http_ffi_client_use_hyper" = "1" ]; then
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
    $ngx_addon_dir/src/ngx_http_ffi_client_hyper.c"
fi

CORE_INCS="$CORE_INCS $ngx_http_ffi_client_lua_module_dir/src/api"
